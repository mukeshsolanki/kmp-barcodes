  <artifactId>kmp-barcodes-scanner-iosarm64</artifactId>
  <version>0.1.0</version>
  <packaging>klib</packaging>
  <name>kmp-barcodes-scanner</name>
  <description>Barcode generation and scanning for Kotlin Multiplatform and Compose Multiplatform on Android and iOS.</description>
  <url>https://github.com/mukeshsolanki/kmp-barcodes</url>
